DISCORD_TOKEN=replace_with_bot_token
DISCORD_CLIENT_ID=replace_with_application_id
# Optional: registers the command instantly in one test server.
DISCORD_GUILD_ID=replace_with_test_server_id
PORT=3000

# Roblox Open Cloud (server-side only; never share this key in Discord/GitHub)
ROBLOX_API_KEY=replace_with_open_cloud_key
ROBLOX_CREATOR_TYPE=Group
ROBLOX_CREATOR_ID=replace_with_group_or_user_id
# Limit direct uploads to selected Discord servers. The plural values are comma-separated.
# Keep the singular values for backward compatibility or one-server setups.
ROBLOX_UPLOAD_GUILD_ID=replace_with_discord_server_id
ROBLOX_UPLOAD_GUILD_IDS=
ROBLOX_UPLOAD_ROLE_ID=replace_with_uploader_role_id
ROBLOX_UPLOAD_ROLE_IDS=
# To allow every role in the selected servers, set ROBLOX_UPLOAD_ROLE_ID to
# the primary ROBLOX_UPLOAD_GUILD_ID (or set ROBLOX_UPLOAD_ROLE_IDS=*).
# Optional comma-separated owner IDs that may upload from any configured server.
ROBLOX_UPLOAD_USER_IDS=

# Optional for local development. Railway Docker already bundles yt-dlp.
YT_DLP_PATH=yt-dlp
